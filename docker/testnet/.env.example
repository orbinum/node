# ─────────────────────────────────────────────────────────────────────────────
# Orbinum Testnet — VALIDATOR node environment (docker-compose.yml)
#
# Copy to `.env` on the validator VPS and fill in the values below.
# For an RPC / bootnode VPS use `.env.rpc.example` instead.
# ─────────────────────────────────────────────────────────────────────────────

# Container image (override to pin a specific tag)
ORBINUM_IMAGE=ghcr.io/orbinum/node:testnet-latest

# Friendly name shown in telemetry. Pick something identifiable.
VALIDATOR_NAME=Choose-Your-Validator-Name

# This validator's libp2p node-key (hex, 64 chars). Generate with:
#   openssl rand -hex 32
VALIDATOR_NODE_KEY=

# ── Joining the public testnet (most external validators) ────────────────────
# Leave the three vars below EMPTY / default. The node binds P2P on
# 0.0.0.0:30333, auto-detects its public address, and discovers the network
# through the public bootNodes baked into testnet-spec.json (the Orbinum RPC
# sentries). Just make sure TCP port 30333 is open and publicly reachable.
P2P_PUBLIC_ADDR=
RESERVED_NODES=
P2P_BIND=0.0.0.0

# ── Private sentry validators ONLY (private network) ─────────────────────────
# Internal validators sit behind RPC sentries on a private network and never
# expose P2P publicly. To run in that mode, set the three vars above like this,
# replacing the private IPs and PeerIds with your own infra's values:
#   P2P_BIND=<this-validator-private-ip>
#   P2P_PUBLIC_ADDR=--public-addr /ip4/<this-validator-private-ip>/tcp/30333
#   RESERVED_NODES=--reserved-nodes /ip4/<peer-private-ip>/tcp/30333/p2p/<peer-peer-id> --reserved-nodes /ip4/<peer-private-ip>/tcp/30333/p2p/<peer-peer-id>
