# ─────────────────────────────────────────────────────────────────────────────
# Orbinum Testnet — node environment
#
# Copy to `.env` on each VPS and fill in the values for THAT node's role.
# A validator VPS uses the validator block; an RPC VPS uses the RPC block.
# ─────────────────────────────────────────────────────────────────────────────

# Container image (override to pin a specific tag)
ORBINUM_IMAGE=ghcr.io/orbinum/node:testnet-latest

# ── VALIDATOR nodes (docker-compose.yml) ─────────────────────────────────────
# Friendly name shown in telemetry. Use Orbinum-Validator-1 / -2 / -3.
VALIDATOR_NAME=Orbinum-Validator-1

# This validator's libp2p node-key (hex, 64 chars). Generated per validator.
# NOTE: for a SENTRY validator this PeerId is NOT published in bootNodes.
VALIDATOR_NODE_KEY=

# This VPS's Hetzner PRIVATE network IP (e.g. 10.0.0.20). P2P binds here only.
PRIVATE_IP=10.0.0.20

# The two RPC sentries this validator is allowed to peer with.
# Format: /ip4/<RPC_PRIVATE_IP>/tcp/30333/p2p/<RPC_PEER_ID>
RPC1_RESERVED=/ip4/10.0.0.10/tcp/30333/p2p/12D3KooW...RPC1
RPC2_RESERVED=/ip4/10.0.0.11/tcp/30333/p2p/12D3KooW...RPC2

# ── RPC / bootnode nodes (docker-compose.rpc.yml) ────────────────────────────
RPC_NAME=Orbinum-RPC-1
# This RPC's libp2p node-key (hex). Its PeerId goes PUBLIC in bootNodes.
RPC_NODE_KEY=
