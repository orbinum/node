# ─────────────────────────────────────────────────────────────────────────────
# Orbinum Testnet — RPC / bootnode environment (docker-compose.rpc.yml)
#
# Copy to `.env` on the RPC VPS and fill in the values below.
# For a validator VPS use `.env.example` instead.
# ─────────────────────────────────────────────────────────────────────────────

# Container image (override to pin a specific tag)
ORBINUM_IMAGE=ghcr.io/orbinum/node:testnet-latest

# Friendly name shown in telemetry. Use rpc-1 / rpc-2 / ... per node.
RPC_NAME=Orbinum-RPC-1

# This RPC's libp2p node-key (hex, 64 chars). Generate with:
#   openssl rand -hex 32
# NOTE: this node's PeerId goes PUBLIC in bootNodes — keep the key stable.
RPC_NODE_KEY=

# Public domain for this RPC. Caddy terminates TLS here with a Cloudflare
# Origin Certificate (origin.pem / origin.key) and proxies HTTPS/WSS to
# localhost:9944. The DNS record must be Proxied (orange cloud) in Cloudflare.
# Use rpc-1 / rpc-2 / ... per node.
RPC_DOMAIN=rpc-1.testnet.orbinum.io

# Resource caps for the node container, so a query flood can't starve the host
# (Caddy, SSH, the OS). Always leave some RAM and CPU for the host — never give
# the container the full core count. The values below are an example for a
# minimum-spec VPS (2 vCPU / 8 GB); scale up to match your server.
RPC_MEM_LIMIT=6g
RPC_CPUS=1.5

# ── private-rpc only (docker-compose.private-rpc.yml) ────────────────────────
# The public RPC (docker-compose.rpc.yml) ignores everything below.
#
# Node cache sizes. Keep these comfortably under RPC_MEM_LIMIT or the node
# OOM-kills mid-sync and its RPC consumer (the indexer writer) stalls. Defaults
# suit a 3 GB cap; raise on a bigger box for faster sync.
#   RPC_DB_CACHE    — RocksDB cache in MB   (--db-cache)
#   RPC_TRIE_CACHE  — trie cache in BYTES   (--trie-cache-size), 67108864 = 64 MiB
RPC_DB_CACHE=512
RPC_TRIE_CACHE=67108864

# Peering. Leave EMPTY to join via the spec's DNS bootNodes.
# When those bootNodes sit behind a proxy/CDN that doesn't route P2P (port
# 30333), dial the existing RPC nodes by IP instead:
#   RESERVED_NODES=--reserved-nodes /ip4/<rpc-ip>/tcp/30333/p2p/<rpc PeerId> --reserved-nodes /ip4/<rpc-ip>/tcp/30333/p2p/<rpc PeerId>
RESERVED_NODES=
