# ─────────────────────────────────────────────────────────────────────────────
# Orbinum Testnet — RPC / bootnode environment (docker-compose.rpc.yml)
#
# Copy to `.env` on the RPC VPS and fill in the values below.
# For a validator VPS use `.env.example` instead.
# ─────────────────────────────────────────────────────────────────────────────

# Container image (override to pin a specific tag)
ORBINUM_IMAGE=ghcr.io/orbinum/node:testnet-latest

# Friendly name shown in telemetry. Use rpc-1 / rpc-2 / ... per node.
RPC_NAME=Orbinum-RPC-1

# This RPC's libp2p node-key (hex, 64 chars). Generate with:
#   openssl rand -hex 32
# NOTE: this node's PeerId goes PUBLIC in bootNodes — keep the key stable.
RPC_NODE_KEY=

# Public domain for this RPC. Caddy terminates TLS here (Let's Encrypt) and
# proxies HTTPS/WSS to localhost:9944. Must already have a DNS A record
# pointing to this VPS's public IP. Use rpc-1 / rpc-2 / ... per node.
RPC_DOMAIN=rpc-1.testnet.orbinum.io
