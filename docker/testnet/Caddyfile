# caddy-ratelimit is not a standard directive, so it must be ordered explicitly.
{
	order rate_limit before basic_auth
}

{$RPC_DOMAIN:rpc-1.testnet.orbinum.io} {
	tls /etc/caddy/origin.pem /etc/caddy/origin.key

	# ── CORS on EVERY response, including 429/5xx ───────────────────────────────
	# The node sets CORS via --rpc-cors, but the rate-limit 429 below is produced
	# by Caddy and never reaches the node — so it would ship WITHOUT CORS headers,
	# and the browser turns it into an opaque "CORS error" instead of a 429 the
	# client could retry. Adding the headers here applies them to all responses.
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type"
		Access-Control-Max-Age "86400"
	}

	# Preflight: answer 204 directly, never hitting the backend or the limiter.
	@options method OPTIONS
	respond @options 204

	# Per-IP rate limit (keyed on the real client IP from Cloudflare). Sized for a
	# public testnet RPC: explorers, wallets and light bots issue bursts, so 10/s
	# (the old 100/10s) throttled legitimate use and took down the explorer. 50/s
	# gives headroom while still capping a single abusive IP.
	rate_limit {
		zone rpc {
			key {http.request.header.CF-Connecting-IP}
			events 500
			window 10s
		}
	}

	reverse_proxy localhost:9944
}
